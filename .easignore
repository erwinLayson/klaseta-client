# EAS Build ignore file
# https://docs.expo.dev/build-reference/easignore/
# When .easignore exists, EAS CLI uses it INSTEAD of .gitignore.

# Dependencies
node_modules/

# Expo & Build outputs
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Debug & Logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS
.DS_Store
*.pem

# Local environment files
.env*.local

# TypeScript
*.tsbuildinfo

# Generated native folders (Managed workflow / CNG)
/ios
/android

# ---------------------------------------------------------------------------
# Test files, test suites, and testing artifacts
# ---------------------------------------------------------------------------
test/
tests/
__tests__/
*.test.ts
*.test.tsx
*.test.js
*.test.jsx
*.spec.ts
*.spec.tsx
*.spec.js
*.spec.jsx
coverage/
.nyc_output/
scratch/

